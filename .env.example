# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Employee Profile Platform"

# Login rate limits (shared across backend workers)
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=300
LOGIN_LOCK_MINUTES=15

SECRET_KEY=changethis
PI_SERVICE_TOKEN=changethis
# Local Python clients can override PI_URL; Compose uses http://pi:8081.
# PI_URL=http://127.0.0.1:8081
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Synthetic data only; turn off for non-demo deployments
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=demo-password-2026

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Default API listener: 127.0.0.1:8000
# API_BIND=127.0.0.1
# API_PORT=8000

# Mock Jira (development and --demo only; synthetic data)
# MOCK_JIRA_EMAIL=jira-admin@example.com
# MOCK_JIRA_API_TOKEN=mock-cloud-token
# MOCK_JIRA_PAT=mock-dc-pat
# MOCK_JIRA_USERNAME=jira-admin
# MOCK_JIRA_PASSWORD=mock-password
